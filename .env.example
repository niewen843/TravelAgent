# 复制为项目根目录 .env，填写你实际创建的 MySQL 库、账号和 Redis 密码。
# 后端 local profile 自动读取；docker compose 也从根目录 .env 读取。
# 使用简单 KEY=VALUE，不加 export，不把真实 .env 提交到 Git。
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=travel_agent
MYSQL_USER=travel_agent
MYSQL_PASSWORD=replace-with-your-database-password
# 仅 Compose 初始化 MySQL 时使用，后端不会使用 root 账号。
MYSQL_ROOT_PASSWORD=replace-with-your-mysql-root-password
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-your-redis-password
