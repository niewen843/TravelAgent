# 本机 IDE 配置与编辑器临时文件
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~

# 环境配置可能包含数据库、Redis 和管理员凭证；只提交脱敏的示例文件。
.env
.env.*
!.env.example
!.env.*.example

# Node 依赖、前端构建和工具缓存；package-lock.json 需要提交。
node_modules/
/frontend/dist/
/frontend/dist-ssr/
.vite/
.vite-temp/
.cache/
*.tsbuildinfo

# Maven 编译、测试报告和打包产物；mvnw、mvnw.cmd、.mvn/ 配置需要提交。
/backend/target/
*.class
*.hprof
hs_err_pid*
replay_pid*

# 测试覆盖率产物；测试源码和测试 Mapper XML 需要提交。
coverage/
.nyc_output/

# 运行日志与进程标记
logs/
*.log
*.log.*
*.pid
*.pid.lock
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# 本地数据库数据与备份；不要忽略 *.sql，docs/sql 中的建表脚本需要提交。
/mysql-data/
/redis-data/
/backups/
/dumps/
dump.rdb
appendonly.aof
appendonlydir/

# 操作系统生成文件
.DS_Store
._*
Thumbs.db
Desktop.ini
